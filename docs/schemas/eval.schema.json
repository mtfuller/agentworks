{
  "$id": "https://github.com/mtfuller/agentworks/docs/schemas/eval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cases": {
      "items": {
        "properties": {
          "artifact": {
            "type": "string"
          },
          "case": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer"
          },
          "passes": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "runs": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "usage": {
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ],
            "type": "object"
          }
        },
        "required": [
          "artifact",
          "path",
          "status",
          "runs",
          "passes",
          "duration_ms"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "command": {
      "const": "eval",
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "summary": {
      "properties": {
        "failed": {
          "type": "integer"
        },
        "ran": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        }
      },
      "required": [
        "ran",
        "failed",
        "skipped"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "command",
    "ok",
    "summary",
    "cases"
  ],
  "title": "agentworks eval --json",
  "type": "object"
}
